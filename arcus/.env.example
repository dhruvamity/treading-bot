# The credentials of every part (Arcus, Lighter, the arbitrage, daytrade, delta neutral) and of the one Telegram bot.
# `make install` copies this to `.env` (gitignored, chmod 600) when there is none: fill in only what you use.
# The bot asks the venues for everything else: which subaccount a key trades, when it expires, account indexes.
# Check with:  arcus doctor

# ---- Arcus ----------------------------------------------------------------------------------------------------------
# Wallet address that owns the API key, and the key's private part (Arcus web app > API Keys > Generate).
# One key per subaccount; for a second subaccount add ARCUS_API_PRIVATE_KEY_2=...
ARCUS_ADDRESS=
ARCUS_API_PRIVATE_KEY=

# ---- Telegram: ONE bot for every part (Arcus; /l_, /arb_, /dt_, /dn_ for the others) ---------------------------------
# @BotFather gives the token; send your bot a message, then read chat.id from api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: only these Telegram user ids may send commands (get yours with /whoami). Recommended in group chats.
TELEGRAM_ALLOWED_USER_IDS=
# Set to 1 to allow LIVE Arcus runs from `arcus pilot approve --live` or the Telegram Run buttons.
# Empty = paper only. Each live start still needs `doctor` to pass and a typed confirmation.
BOT_PILOT_LIVE=

# ---- Two machines (optional; the README, section 3) ------------------------------------------------------------------
# What this machine is for. Empty or all = everything on one machine. trader = Telegram and the runs (no recording,
# no scans). recorder = the tape only. scout = the tape and the scans. A recorder or a scout machine needs no keys.
BOT_ROLE=
# On a trader only: the machine that makes the lists, as user@host or user@host:port, and the key it fetches with
# (`tbot sync key` makes it; `tbot sync allow` on the other machine lets it in for that one thing).
BOT_SYNC_FROM=
BOT_SYNC_KEY=

# ---- Lighter (Robinhood Chain): only for LIVE Lighter runs; recording and paper need none of it ---------------------
# The wallet that owns the account, and the API key registered for it (lighter/README.md, section 2;
# `lighter keys` makes a pair, lighter/scripts/register_key.py registers it).
LIGHTER_ADDRESS=
LIGHTER_API_PRIVATE_KEY=
LIGHTER_API_KEY_INDEX=4
LIGHTER_ACCOUNT_INDEX=
# mainnet or testnet
LIGHTER_ENV=mainnet
# 1 allows LIVE Lighter runs (each still needs a passing `lighter doctor` and a typed confirmation).
LBOT_LIVE=

# ---- Funding arbitrage between Arcus and Lighter --------------------------------------------------------------------
# It trades with the keys above. The Arcus subaccount it reads and trades (default 0): it uses the key bound to that
# subaccount, so a subaccount of its own needs its own key (ARCUS_API_PRIVATE_KEY_2=...). A part's own .env wins over
# this file: ARCUS_ACCOUNT_INDEX in arbitrage/.env or deltaneutral/.env gives that part another subaccount.
ARCUS_ACCOUNT_INDEX=0
# 1 allows the LIVE arbitrage (each start still needs LIVE typed, or a code typed back in Telegram).
ARB_LIVE=
# Optional: ProFunding data key, a cross-check of the funding rates (read-only; never give it an exchange key).
PROFUNDING_API_KEY=

# ---- Delta neutral: two markets, long on one venue and short on the other (deltaneutral/README.md) -----------------
# It trades with the keys above, on ARCUS_ACCOUNT_INDEX's subaccount (as the arbitrage) and the Lighter account.
# 1 allows LIVE (each start still needs LIVE typed). Give it a subaccount and a key of its own.
DN_LIVE=

# ---- Daytrade (paper only): a free Alpaca data key, for `daytrade fetch alpaca` (SPY and QQQ by the minute) ------
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
