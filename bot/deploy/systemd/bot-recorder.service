[Unit]
Description=market-data recorder (public data, 24/7)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
WorkingDirectory=/opt/bot
EnvironmentFile=/etc/bot.env
ExecStart=/opt/bot/.venv/bin/bot record
Restart=always
RestartSec=5
MemoryMax=3G
Nice=5

[Install]
WantedBy=multi-user.target
