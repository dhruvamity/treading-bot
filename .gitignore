# The repository is exactly this: three bots, one README, one Makefile and the CI. Anything else at the top level
# (your research folders, downloaded docs, archives, exports) is yours and is never committed.
/*
!/.gitignore
!/.github/
!/README.md
!/Makefile
!/arcus/
!/lighter/
!/arbitrage/

# ---- credentials: never commit ---------------------------------------------------------------------------------
.env
.env.*
!.env.example
**/config/secrets.enc
*.pem
*.key
*.p12

# ---- what a bot writes while it runs: recorded data, state, logs, your settings and notes -------------------------
/arcus/data/
/arcus/state/
/arcus/logs/
/arcus/reports/
/arcus/handoffs/
/arcus/CONTEXT.md
/arcus/OWNER_ACTIONS.md
/arcus/config/sessions/pilot.yaml
/arcus/config/*.tmp
/lighter/data/
/lighter/state/
/lighter/logs/
/lighter/reports/
/lighter/config/sessions/
/lighter/OWNER_ACTIONS.md
/arbitrage/data/
/arbitrage/state/
/arbitrage/settings.json
/arbitrage/OWNER_ACTIONS.md
*.sqlite
*.sqlite-*
*.npz
*.parquet
*.pkl
*.pid
*.tgz
*.tar
*.tar.gz
*.tar.zst

# ---- Python and tooling -------------------------------------------------------------------------------------
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.DS_Store
.claude/
