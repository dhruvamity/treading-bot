# The funding arbitrage reads the trading bot's ONE credentials file: treading-bot/bot/.env (see bot/.env.example,
# the "Funding arbitrage" lines). Nothing needs to be here.
#
# This file is only for running arb/ on its own, without the rest of the bot: copy it to arb/.env (gitignored,
# chmod 600). Whatever is set here wins over bot/.env.

# The accounts whose free collateral the scanner reads (public by address / index):
ARCUS_ADDRESS=
ARCUS_ACCOUNT_INDEX=0
LIGHTER_ACCOUNT_INDEX=
# ProFunding data key (profunding.pro; read-only use, the free tier allows 100 requests a day). Optional.
PROFUNDING_API_KEY=
# 1 allows the live executor (a typed LIVE, or a code typed back in Telegram, is still asked each time).
ARB_LIVE=
