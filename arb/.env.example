# Copy to `.env` (gitignored, chmod 600).
# The accounts whose free collateral the scanner reads (public by address / index):
ARCUS_ADDRESS=
ARCUS_ACCOUNT_INDEX=0
LIGHTER_ACCOUNT_INDEX=
# ProFunding data key (profunding.pro; read-only use, the free tier allows 100 requests a day). Optional.
PROFUNDING_API_KEY=

# ---- Live trading ---------------------------------------------------------------------------------------------------
# 1 allows `arb run --live` (it still asks for LIVE to be typed). Empty = paper only.
# The trading keys are not here: Arcus's is in bot/.env, Lighter's in lighter/.env.
ARB_LIVE=

# ---- Telegram (optional) --------------------------------------------------------------------------------------------
# Its own bot (@BotFather -> /newbot), not the Arcus or the Lighter bot's.
ARB_TELEGRAM_TOKEN=
ARB_TELEGRAM_CHAT_ID=
# Only these Telegram user ids may send commands (/whoami shows yours).
ARB_TELEGRAM_USERS=
