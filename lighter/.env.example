# Lighter bot credentials. Copy to `.env` (gitignored, chmod 600) and fill in what you use.
# Recording, backtests and paper runs need none of it.

# ---- Lighter on Robinhood Chain -------------------------------------------------------------------------------------
# The wallet (L1) address that owns the Lighter account, and an API key's private part. The bot finds the account
# index from the address; set LIGHTER_ACCOUNT_INDEX only to trade a sub-account.
LIGHTER_ADDRESS=
LIGHTER_API_PRIVATE_KEY=
# The API key's slot (2-254; 0-3 and 157 are the web and mobile apps'). Default 4.
LIGHTER_API_KEY_INDEX=4
LIGHTER_ACCOUNT_INDEX=
# mainnet or testnet
LIGHTER_ENV=mainnet

# ---- Live trading ---------------------------------------------------------------------------------------------------
# 1 allows LIVE runs (each still needs `lbot doctor` to pass and a typed confirmation). Empty = paper only.
LBOT_LIVE=

# ---- Telegram (optional) --------------------------------------------------------------------------------------------
# Its own bot, not the Arcus bot's: two programs cannot read one bot's messages. @BotFather -> /newbot.
LBOT_TELEGRAM_TOKEN=
LBOT_TELEGRAM_CHAT_ID=
# Only these Telegram user ids may send commands (get yours with /whoami).
LBOT_TELEGRAM_USERS=
