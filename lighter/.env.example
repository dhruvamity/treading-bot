# The Lighter part reads the trading bot's ONE credentials file: treading-bot/bot/.env (see bot/.env.example, the
# "Lighter" lines). Nothing needs to be here, and recording, backtests and paper runs need no credentials at all.
#
# This file is only for running lighter/ on its own, without the rest of the bot: copy it to lighter/.env
# (gitignored, chmod 600). Whatever is set here wins over bot/.env.

# The wallet (L1) address that owns the Lighter account, and an API key's private part. The bot finds the account
# index from the address; set LIGHTER_ACCOUNT_INDEX only to trade a sub-account.
LIGHTER_ADDRESS=
LIGHTER_API_PRIVATE_KEY=
# The API key's slot (2-254; 0-3 and 157 are the web and mobile apps'). Default 4.
LIGHTER_API_KEY_INDEX=4
LIGHTER_ACCOUNT_INDEX=
# mainnet or testnet
LIGHTER_ENV=mainnet
# 1 allows LIVE runs (each still needs the doctor to pass and a typed confirmation). Empty = paper only.
LBOT_LIVE=
